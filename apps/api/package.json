    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bullmq": "^5.77.6",
    "dotenv": "^17.4.1",
    "ioredis": "^5.11.0",
    "openai": "^6.41.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "pgvector": "^0.3.0",
    "prisma": "^7.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
